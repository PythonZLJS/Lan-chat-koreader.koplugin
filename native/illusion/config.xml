<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.neighbourchat.illusion" version="7.1" viewmodes="application" xmlns="http://www.w3.org/ns/widgets" xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions">
  <name xml:lang="en">Neighbour Chat</name><description xml:lang="en">Host and join nearby chats.</description><content src="index.html"/>
  <kindle:permissions><kindle:permission name="local-port-access"/></kindle:permissions>
  <kindle:network><kindle:asset key="initialDNS" value="false"/><kindle:asset key="overrideProxy" value="none"/><kindle:asset key="enableCaching" value="false"/></kindle:network>
  <kindle:cookiejar><kindle:asset key="persistent" value="false"/><kindle:asset key="usePrivateCookies" value="true"/><kindle:asset key="useDeviceCookies" value="false"/><kindle:asset key="useAccessToken" value="false"/></kindle:cookiejar>
  <kindle:chrome><kindle:asset key="configureSearchBar" value="system"/></kindle:chrome>
  <kindle:gestures><kindle:param name="tap" value="yes" properties="fire_on_tap:1 max_updown_delta:0"/><kindle:param name="swipe" value="yes"/></kindle:gestures>
  <feature name="http://kindle.amazon.com/apis" required="true"><param name="appmgr" value="yes"/><param name="net" value="yes"/><param name="gestures" value="yes"/><param name="chrome" value="yes"/></feature>
  <kindle:settings><kindle:setting name="internetRequired" value="no"/><kindle:setting name="saveContext" value="no"/><kindle:setting name="disable-wua-features" value="yes"/></kindle:settings>
</widget>
